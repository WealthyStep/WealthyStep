# ==========================================
# WEALTHY STEP ENVIRONMENT CONFIGURATION
# ==========================================

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Chatbot Email Delivery (Brevo SMTP Settings)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_TO=your-business@example.com
EMAIL_FROM=noreply@yourdomain.com

# ------------------------------------------
# SUPABASE CONFIGURATION (DB & Auth)
# ------------------------------------------
# Public client credentials (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side service role key (NEVER expose to client!)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------
# BACKBLAZE B2 STORAGE (S3-Compatible)
# ------------------------------------------
# e.g., s3.us-east-005.backblazeb2.com (without https://)
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=005xxxxxxxxxxxxxxxxxx00000001
B2_APPLICATION_KEY=K005xxxxxxxxxxxxxxxxxxxxxxxxxxx
B2_BUCKET_NAME=wealthystep-policy-vault

# ------------------------------------------
# BREVO TRANSACTIONAL EMAIL (OTP Delivery)
# ------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@wealthystep.com

# ------------------------------------------
# SECURITY PEPPER (For hashing OTP codes)
# ------------------------------------------
# A secure random string used to salt/pepper OTP hashes
OTP_PEPPER=your-secure-random-secret-pepper-string-here
