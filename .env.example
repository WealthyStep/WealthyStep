# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Chatbot Email Delivery (Brevo SMTP Settings)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false

# Your exact Brevo login email and SMTP API Key
SMTP_USER=your-brevo-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key

# Where should the chatbot send the enquiries? (e.g. your business email)
EMAIL_TO=your-business@example.com

# What email address should the email appear to come from? 
EMAIL_FROM=noreply@yourdomain.com
